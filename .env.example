# Copy to .env and adjust. Everything has a working default except HOST_UID/HOST_GID,
# which must match the owner of NOVEL_DATA_DIR.

# --- Database
POSTGRES_USER=novel
POSTGRES_PASSWORD=change_me
POSTGRES_DB=novel_companion

# --- Language model: any OpenAI-compatible endpoint.
# Default: the vllm service (`docker compose --profile gpu up -d`, or scripts/start_vllm.sh).
# A hosted provider works by changing these three, e.g. LLM_BASE_URL=https://api.openai.com/v1
# with a model name and key, and then no GPU is needed.
LLM_BASE_URL=http://vllm:8000/v1
LLM_MODEL=mistralai/Mistral-Nemo-Instruct-2407
LLM_API_KEY=

# --- Local model server (only with the gpu profile)
VLLM_GPU=0
# Hugging Face cache holding the weights (downloaded there on first start unless offline).
# Defaults to $HOME/.cache/huggingface; use an absolute path if overriding (no ~).
# HF_CACHE_DIR=/home/you/.cache/huggingface
# 1 = never download; serve only what is already cached
HF_HUB_OFFLINE=0

# --- Novel files: this directory is mounted read-only at /novels in the ingestion worker,
# which runs as HOST_UID:HOST_GID so it can read them. Use `id -u` and `id -g`.
NOVEL_DATA_DIR=./data/novels
HOST_UID=1000
HOST_GID=1000

# --- Browser access
# Where the browser reaches the gateway (baked into the frontend at build time)
PUBLIC_API_URL=http://localhost:8000
# Origins allowed to call the gateway from a browser (comma-separated)
CORS_ORIGINS=http://localhost:3000
