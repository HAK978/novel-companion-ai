# PostgreSQL
POSTGRES_USER=novel
POSTGRES_PASSWORD=change_me
POSTGRES_DB=novel_companion

# Infrastructure
REDIS_URL=redis://redis:6379/0
CHROMADB_URL=http://chromadb:8000

# Language model: any OpenAI-compatible endpoint. The default is the local vLLM server
# started by scripts/start_services.sh; a hosted provider works by changing these three.
LLM_BASE_URL=http://localhost:8004/v1
LLM_MODEL=mistralai/Mistral-Nemo-Instruct-2407
LLM_API_KEY=

# Browser origins allowed to call the gateway (comma-separated)
CORS_ORIGINS=http://localhost:3000
